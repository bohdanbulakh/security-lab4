{
  "info": {
    "_postman_id": "46e1bc6f-5bfe-4829-b0cc-9d18a60d90bd",
    "name": "Security lab 4",
    "description": "Запити до застосунку лаб. 4 (token_auth + Auth0: password grant, створення користувача, refresh token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User created', () => pm.response.to.have.status(201));",
              "pm.environment.set('user_id', pm.response.json().user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "pm.environment.set('session_token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (wrong password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejected by Auth0', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{session_token}}",
            "description": "id сесії застосунку, без префікса Bearer"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authorized', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().token;",
              "const prev = pm.environment.get('access_token');",
              "if (prev && prev !== t.accessToken) console.log('Access token was refreshed by server');",
              "pm.environment.set('access_token', t.accessToken);",
              "console.log(`expiresIn=${t.expiresIn}s, refreshCount=${t.refreshCount}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{session_token}}",
            "description": "id сесії застосунку, без префікса Bearer"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "refresh"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token refreshed', () => pm.response.to.have.status(200));",
              "const t = pm.response.json().token;",
              "pm.test('Access token changed', () => pm.expect(t.accessToken).to.not.eql(pm.environment.get('access_token')));",
              "pm.environment.set('access_token', t.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{session_token}}",
            "description": "id сесії застосунку, без префікса Bearer"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged out', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}